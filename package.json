{
  "name": "kaoi",
  "version": "2.0.0",
  "description": "A fully Object Oriented WhatsApp bot built with TypeScript",
  "main": "dist/kaoi.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/kaoi.js",
    "v3:start": "node dist/v3/app/bootstrap/V3Server.js",
    "v3:e2e": "node dist/v3/testing/E2eTest.js",
    "lint": "eslint \"src/**/*.ts\"",
    "prettier-format": "prettier --config .prettierrc \"src/**/*.ts\" --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test:unit": "npm run build && node --test dist/v3/testing/unit/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrajjwalDatir/Kaoi.git"
  },
  "keywords": [
    "bot",
    "typescript",
    "whatsapp",
    "whatsapp-botto-void",
    "kaoi"
  ],
  "author": "Synthesized Infinity & Prajjwal Datir",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/PrajjwalDatir/Kaoi/issues"
  },
  "homepage": "https://github.com/PrajjwalDatir/Kaoi#readme",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/gifencoder": "^2.0.3",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.1",
    "@types/yt-search": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "prettier": "^3.1.1",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "axios": "^1.20.0",
    "drizzle-orm": "^0.45.2",
    "qs": "^6.16.0",
    "sharp": "^0.35.4",
    "file-type": "^21.3.4",
    "undici": "^7.0.0",
    "tar": "^7.5.0",
    "brace-expansion": "^2.0.2",
