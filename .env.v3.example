# V3 configuration
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/whatsappbot
DATABASE_POOL_MAX=5
PORT=3000
LOG_LEVEL=info

# Required before enabling encrypted session backups
# Minimum 32 characters; never commit the real value.
SESSION_BACKUP_KEY=replace-with-a-random-32-plus-character-secret
