# V3 configuration
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/whatsappbot
DATABASE_POOL_MAX=5
PORT=3000
LOG_LEVEL=info

# Dashboard authentication
SESSION_COOKIE_NAME=v3_session
SESSION_TTL_MS=86400000
# true in HTTPS deployments; false for local HTTP development
SESSION_SECURE=false
# Generate with: openssl rand -hex 32
CSRF_SECRET=replace-with-a-random-32-plus-character-secret

# Required before enabling encrypted WhatsApp session backups
# Generate with: openssl rand -hex 32
SESSION_BACKUP_KEY=replace-with-a-random-32-plus-character-secret
